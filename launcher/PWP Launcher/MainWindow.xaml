<Window x:Class="PWPLuncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PWP Launcher"
        Width="860" Height="580"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BrushBorder}">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ═══ Custom Title Bar ═══ -->
            <Grid Grid.Row="0" Background="{StaticResource BrushBgCard}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#x2694;" FontSize="18" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TitleText" Text="PWP LAUNCHER" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" x:Name="TitleBarButtons">
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click"
                            Width="42" Height="38" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            Style="{StaticResource GhostButton}">
                        <TextBlock Text="&#x2500;" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="BtnClose" Click="BtnClose_Click"
                            Width="42" Height="38" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            Style="{StaticResource GhostButton}">
                        <TextBlock Text="&#x2715;" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                        Background="{StaticResource BrushBorder}" />
            </Grid>

            <!-- Separator -->
            <Grid Grid.Row="1" />

            <!-- ═══ Main Content Area (Panel Switcher) ═══ -->
            <Grid Grid.Row="2" Margin="0">

                <!-- ─── Panel 1: LOGIN ─── -->
                <Grid x:Name="PanelLogin" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <TextBlock Text="&#x2694; PWP" FontSize="48" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="PIGEO STUDIOS WARFARE PROJECT"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,32,0,0" Width="320">
                        <TextBlock Text="ЛОГИН" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                        <TextBox x:Name="LoginBox" Height="36" FontSize="14" />
                    </StackPanel>

                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,12,0,0" Width="320">
                        <TextBlock Text="ПАРОЛЬ" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                        <PasswordBox x:Name="PasswordBox" Height="36" FontSize="14" Style="{StaticResource PasswordBoxStyle}" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" HorizontalAlignment="Center" Margin="0,20,0,0" Width="320">
                        <Button x:Name="BtnLogin" Content="ВОЙТИ"
                                Height="44" FontSize="16" FontWeight="Bold"
                                Click="BtnLogin_Click"
                                Style="{StaticResource PlayButton}" />
                        <TextBlock x:Name="LoginError" Text=""
                                   Foreground="{StaticResource BrushRed}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12" />
                        <TextBlock x:Name="LoginStatus" Text=""
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,4,0,0" FontSize="11" />
                    </StackPanel>
                </Grid>

                <!-- ─── Panel 2: 2FA ─── -->
                <Grid x:Name="Panel2FA" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="ДВУХФАКТОРНАЯ АУТЕНТИФИКАЦИЯ"
                                   FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="Код отправлен в Telegram"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Width="280">
                        <TextBox x:Name="TfaCodeBox" Height="44" FontSize="24"
                                 HorizontalContentAlignment="Center"
                                 MaxLength="6" TextAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,16,0,0" Width="280">
                        <Button x:Name="BtnVerify2FA" Content="ПОДТВЕРДИТЬ"
                                Height="40" FontSize="14" FontWeight="Bold"
                                Click="BtnVerify2FA_Click"
                                Style="{StaticResource PlayButton}" />
                        <TextBlock x:Name="TfaError" Text=""
                                   Foreground="{StaticResource BrushRed}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" FontSize="12" />
                    </StackPanel>
                </Grid>

                <!-- ─── Panel 3: MAIN ─── -->
                <Grid x:Name="PanelMain" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel: Settings -->
                    <Border Grid.Column="0" Background="{StaticResource BrushBgCard}" Padding="14,16">
                        <StackPanel>
                            <TextBlock Text="{Binding ElementName=TitleText, Path=Text}"
                                       FontSize="12" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}"
                                       Margin="0,0,0,16" />

                            <!-- RAM -->
                            <TextBlock Text="RAM" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextMuted}" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Slider x:Name="RamSlider" Grid.Column="0"
                                        Minimum="2" Maximum="16" Value="4"
                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                        ValueChanged="RamSlider_ValueChanged" />
                                <TextBlock x:Name="RamLabel" Grid.Column="1"
                                           Text="4 GB" FontSize="13" FontWeight="Bold"
                                           Foreground="{StaticResource BrushAccent}"
                                           Margin="12,0,0,0" VerticalAlignment="Center" />
                            </Grid>

                            <!-- Path -->
                            <TextBlock Text="ПАПКА УСТАНОВКИ" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,16,0,0" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="PathBox" Grid.Column="0"
                                         IsReadOnly="True" FontSize="11" />
                                <Button x:Name="BtnBrowse" Grid.Column="1"
                                        Content="&#x22EF;" Width="28" Height="28"
                                        Click="BtnBrowse_Click"
                                        Style="{StaticResource BaseButton}"
                                        Padding="0" Margin="4,0,0,0"
                                        FontSize="16" FontWeight="Bold" />
                            </Grid>

                            <!-- Version Info -->
                            <TextBlock Text="ВЕРСИЯ" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,16,0,0" />
                            <TextBlock x:Name="VersionInfo"
                                       Text="Minecraft 1.20.1 &#xB7; Forge 47.3.0"
                                       FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                       Margin="0,4,0,0" />

                            <Separator />

                            <!-- Status -->
                            <StackPanel Margin="0,8,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                             Fill="{StaticResource BrushGreen}"
                                             VerticalAlignment="Center" />
                                    <TextBlock x:Name="StatusText" Text="Готов"
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                               Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="VersionText" Text="Launcher v1.0.0"
                                           FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                                           Margin="0,8,0,0" />
                            </StackPanel>

                            <!-- Mods Button -->
                            <Button x:Name="BtnMods" Content="&#x1F4E6; МОДЫ"
                                    Height="32" Margin="0,12,0,0"
                                    Click="BtnMods_Click"
                                    Style="{StaticResource BaseButton}" FontSize="12" />

                            <!-- Console Button -->
                            <Button x:Name="BtnConsole" Content="&#x1F4BB; КОНСОЛЬ"
                                    Height="32" Margin="0,8,0,0"
                                    Click="BtnConsole_Click"
                                    Style="{StaticResource BaseButton}" FontSize="12" />

                            <!-- Settings Button -->
                            <Button x:Name="BtnSettings" Content="&#x2699; НАСТРОЙКИ"
                                    Height="32" Margin="0,8,0,0"
                                    Click="BtnSettings_Click"
                                    Style="{StaticResource BaseButton}" FontSize="12" />

                            <!-- Logout Button -->
                            <Button x:Name="BtnLogout" Content="&#x2190; ВЫЙТИ"
                                    Height="32" Margin="0,8,0,0"
                                    Click="BtnLogout_Click"
                                    Style="{StaticResource BaseButton}" FontSize="11"
                                    Foreground="{StaticResource BrushTextMuted}" />
                        </StackPanel>
                    </Border>

                    <!-- Right Panel: Main Content -->
                    <Grid Grid.Column="1" Margin="32,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Logo -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,24,0,0">
                            <TextBlock Text="&#x2694; PWP" FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}"
                                       HorizontalAlignment="Center" />
                            <TextBlock x:Name="UserGreeting" Text=""
                                       FontSize="12"
                                       Foreground="{StaticResource BrushTextMuted}"
                                       HorizontalAlignment="Center"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Play button area -->
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Button x:Name="BtnPlay" Content="&#x25B6;  PLAY"
                                    Style="{StaticResource PlayButton}"
                                    Height="60" Width="260"
                                    Click="BtnPlay_Click" />
                            <TextBlock x:Name="PlaySubtext" Text="Нажмите чтобы начать"
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>

                        <!-- Progress -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,24">
                            <ProgressBar x:Name="ProgressBar" Value="0" Height="6" />
                            <TextBlock x:Name="ProgressText" Text=""
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ─── Panel 4: MODS ─── -->
                <Grid x:Name="PanelMods" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="24,16,24,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="&#x2190; НАЗАД"
                                    Style="{StaticResource GhostButton}"
                                    Click="BtnModsBack_Click"
                                    FontSize="12" />
                            <TextBlock Text="ОПЦИОНАЛЬНЫЕ МОДЫ"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}"
                                       Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Выберите моды для загрузки (необязательно)"
                                   FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                   Margin="44,4,0,0" />
                    </StackPanel>

                    <!-- Mod list -->
                    <ScrollViewer Grid.Row="1" Margin="24,12,24,8"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ModsList" />
                    </ScrollViewer>

                    <!-- Bottom buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,8,0,16">
                        <Button x:Name="BtnSelectAll" Content="ВЫБРАТЬ ВСЕ"
                                Style="{StaticResource BaseButton}"
                                Click="BtnSelectAll_Click" Height="32" Margin="0,0,8,0" />
                        <Button x:Name="BtnDeselectAll" Content="СНЯТЬ ВСЕ"
                                Style="{StaticResource BaseButton}"
                                Click="BtnDeselectAll_Click" Height="32" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ─── Panel 5: CONSOLE ─── -->
                <Grid x:Name="PanelConsole" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="24,16,24,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="&#x2190; НАЗАД"
                                    Style="{StaticResource GhostButton}"
                                    Click="BtnConsoleBack_Click"
                                    FontSize="12" />
                            <TextBlock Text="КОНСОЛЬ РАЗРАБОТЧИКА"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}"
                                       Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Log output -->
                    <Border Grid.Row="1" Margin="24,8,24,8"
                            Background="{StaticResource BrushBgInput}"
                            CornerRadius="6" BorderBrush="{StaticResource BrushBorder}"
                            BorderThickness="1">
                        <ScrollViewer x:Name="ConsoleScroll" VerticalScrollBarVisibility="Auto"
                                      Margin="8" Background="Transparent">
                            <TextBox x:Name="ConsoleOutput" IsReadOnly="True"
                                     FontFamily="Consolas" FontSize="11"
                                     Background="Transparent"
                                     Foreground="{StaticResource BrushTextSecondary}"
                                     BorderThickness="0"
                                     TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                        <Button x:Name="BtnSendLogs" Content="&#x1F4E4; ОТПРАВИТЬ ЛОГИ"
                                Style="{StaticResource BaseButton}"
                                Click="BtnSendLogs_Click" Height="32" Margin="0,0,8,0" />
                        <Button x:Name="BtnClearLogs" Content="ОЧИСТИТЬ"
                                Style="{StaticResource BaseButton}"
                                Click="BtnClearLogs_Click" Height="32" Margin="8,0,0,0" />
                    </StackPanel>
                </Grid>
                <!-- ─── Panel 6: SETTINGS ─── -->
                <Grid x:Name="PanelSettings" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <StackPanel Grid.Row="0" Margin="24,16,24,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="&#x2190; НАЗАД"
                                    Style="{StaticResource GhostButton}"
                                    Click="BtnSettingsBack_Click"
                                    FontSize="12" />
                            <TextBlock Text="&#x2699; НАСТРОЙКИ"
                                       FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}"
                                       Margin="16,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Настройки Minecraft и Java"
                                   FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                   Margin="44,4,0,0" />
                    </StackPanel>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1" Margin="24,12,24,8"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel>

                            <!-- ─── RAM ─── -->
                            <Border Background="{StaticResource BrushBgCard}" CornerRadius="6"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                    Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ (RAM)" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BrushAccent}" />
                                    <TextBlock Grid.Row="1" Text="Выделите память для Minecraft"
                                               FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                               Margin="0,4,0,0" />
                                    <Grid Grid.Row="2" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="SettingsRamSlider" Grid.Column="0"
                                                Minimum="2" Maximum="16" Value="4"
                                                TickFrequency="1" IsSnapToTickEnabled="True"
                                                ValueChanged="SettingsRamSlider_ValueChanged" />
                                        <TextBlock x:Name="SettingsRamLabel" Grid.Column="1"
                                                   Text="4 GB" FontSize="14" FontWeight="Bold"
                                                   Foreground="{StaticResource BrushAccent}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- ─── JAVA ─── -->
                            <Border x:Name="JavaCard" Background="{StaticResource BrushBgCard}" CornerRadius="6"
                                    BorderBrush="{StaticResource BrushBorder}" BorderThickness="1"
                                    Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="JAVA" FontSize="12" FontWeight="Bold"
                                               Foreground="{StaticResource BrushAccent}" />
                                    <TextBlock Grid.Row="1" x:Name="JavaStatus" Text="Проверка..."
                                               FontSize="11" Foreground="{StaticResource BrushTextSecondary}"
                                               Margin="0,4,0,0" />
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                        <Button x:Name="BtnJavaDetect" Content="&#x1F50D; Найти Java"
                                                Style="{StaticResource BaseButton}" Height="28" FontSize="11"
                                                Click="BtnJavaDetect_Click" Margin="0,0,8,0" />
                                        <Button x:Name="BtnJavaDownload" Content="&#x2B07; Скачать Java 17"
                                                Style="{StaticResource BaseButton}" Height="28" FontSize="11"
                                                Click="BtnJavaDownload_Click" />
                                    </StackPanel>
                                    <ProgressBar x:Name="JavaProgress" Grid.Row="3" Height="4" Margin="0,8,0,0"
                                                 Visibility="Collapsed" />
                                </Grid>
                            </Border>



                        </StackPanel>
                    </ScrollViewer>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
