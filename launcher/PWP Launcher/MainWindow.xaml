<Window x:Class="PWPLuncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PWP Launcher"
        Width="780" Height="540"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{StaticResource BrushBorder}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Background="{StaticResource BrushBgCard}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#x2694;" FontSize="18" Foreground="{StaticResource BrushAccent}" VerticalAlignment="Center" />
                    <TextBlock Text="PWP LAUNCHER" FontSize="13" FontWeight="Bold"
                               Foreground="{StaticResource BrushTextSecondary}"
                               Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnMinimize" Click="BtnMinimize_Click"
                            Width="42" Height="38" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            Style="{StaticResource GhostButton}">
                        <TextBlock Text="&#x2500;" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="BtnClose" Click="BtnClose_Click"
                            Width="42" Height="38" Background="Transparent"
                            BorderThickness="0" Cursor="Hand"
                            Style="{StaticResource GhostButton}">
                        <TextBlock Text="&#x2715;" FontSize="16" Foreground="{StaticResource BrushTextSecondary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>

                <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                        Background="{StaticResource BrushBorder}" />
            </Grid>

            <!-- Main Content -->
            <Grid Grid.Row="1" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Panel: Settings -->
                <Border Grid.Column="0" Background="{StaticResource BrushBgCard}" Padding="16,24">
                    <StackPanel>
                        <!-- RAM -->
                        <TextBlock Text="RAM" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="RamSlider" Grid.Column="0"
                                    Minimum="2" Maximum="16" Value="4"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    ValueChanged="RamSlider_ValueChanged" />
                            <TextBlock x:Name="RamLabel" Grid.Column="1"
                                       Text="4 GB" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource BrushAccent}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Path -->
                        <TextBlock Text="INSTALL PATH" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,20,0,0" />
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="PathBox" Grid.Column="0"
                                     Text="%AppData%/.pwplauncher"
                                     IsReadOnly="True" />
                            <Button x:Name="BtnBrowse" Grid.Column="1"
                                    Content="&#x22EF;" Width="32" Height="32"
                                    Click="BtnBrowse_Click"
                                    Style="{StaticResource BaseButton}"
                                    Padding="0" Margin="6,0,0,0"
                                    FontSize="18" FontWeight="Bold" />
                        </Grid>

                        <!-- Version Info -->
                        <TextBlock Text="VERSION" FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   Margin="0,20,0,0" />
                        <TextBlock Text="Minecraft 1.20.1 &#xB7; Forge 47.3.0"
                                   FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                   Margin="0,6,0,0" />

                        <Separator />

                        <!-- Status indicator -->
                        <StackPanel Margin="0,8,0,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8"
                                         Fill="{StaticResource BrushGreen}"
                                         VerticalAlignment="Center" />
                                <TextBlock x:Name="StatusText" Text="Ready to launch"
                                           FontSize="12" Foreground="{StaticResource BrushTextSecondary}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="VersionText" Text="Launcher v1.0.0"
                                       FontSize="10" Foreground="{StaticResource BrushTextMuted}"
                                       Margin="0,12,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Right Panel: Main -->
                <Grid Grid.Column="1" Margin="40,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Logo area -->
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,48,0,0">
                        <TextBlock Text="&#x2694; PWP" FontSize="42" FontWeight="Bold"
                                   Foreground="{StaticResource BrushAccent}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="PIGEO STUDIOS WARFARE PROJECT"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center"
                                   Margin="0,6,0,0"
                                   LetterSpacing="2" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button x:Name="BtnPlay" Content="&#x25B6;  PLAY"
                                Style="{StaticResource PlayButton}"
                                Height="60" Width="260"
                                Click="BtnPlay_Click" />
                        <TextBlock x:Name="PlaySubtext" Text="Click to start the game"
                                   FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,12,0,0" />
                    </StackPanel>

                    <!-- Progress -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,24">
                        <ProgressBar x:Name="ProgressBar" Value="0" Height="6" />
                        <TextBlock x:Name="ProgressText" Text=""
                                   FontSize="11" Foreground="{StaticResource BrushTextMuted}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- Footer -->
                    <TextBlock Grid.Row="3" Text="PWP Launcher v1.0.0"
                               FontSize="9" Foreground="{StaticResource BrushTextMuted}"
                               HorizontalAlignment="Center" Margin="0,0,0,8" />
                </Grid>
            </Grid>

            <!-- Resize grip -->
            <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Width="12" Height="12" Background="Transparent" Cursor="SizeNWSE" />
        </Grid>
    </Border>
</Window>
